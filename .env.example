# Host ownership for bind-mounted ./data. On a VPS run `sh scripts/init_vps.sh`
# so these two values match the checkout owner.
BLOODLINES_UID=1000
BLOODLINES_GID=1000

# Telegram bot settings.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_MAX_UPLOAD_MB=20

# Leave empty for direct Telegram access.
# For the optional sing-box sidecar use: socks5://proxy:1080
TELEGRAM_PROXY_URL=
