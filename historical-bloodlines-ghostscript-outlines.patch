+    @staticmethod
+    def _find_ghostscript_executable() -> Path:
+        """Locate Ghostscript on Linux/macOS and common Windows installs."""
+
+        override = os.environ.get("GHOSTSCRIPT_EXE")
+        if override:
+            override_path = Path(override).expanduser()
+            if override_path.is_file():
+                return override_path
+            resolved_override = shutil.which(override)
+            if resolved_override:
+                return Path(resolved_override)
+            raise RuntimeError(
+                "GHOSTSCRIPT_EXE is set but does not point to a Ghostscript "
+                f"executable: {override}"
+            )
+
+        for executable_name in ("gswin64c.exe", "gswin32c.exe", "gs"):
+            resolved = shutil.which(executable_name)
+            if resolved:
+                return Path(resolved)
+
+        windows_candidates: list[Path] = []
+        for environment_name in ("ProgramFiles", "ProgramFiles(x86)"):
+            program_files = os.environ.get(environment_name)
+            if not program_files:
+                continue
+            ghostscript_root = Path(program_files) / "gs"
+            if not ghostscript_root.is_dir():
+                continue
+            windows_candidates.extend(
+                ghostscript_root.glob("gs*/bin/gswin64c.exe")
+            )
+            windows_candidates.extend(
+                ghostscript_root.glob("gs*/bin/gswin32c.exe")
+            )
+
+        existing_candidates = [
+            candidate for candidate in windows_candidates if candidate.is_file()
+        ]
+        if existing_candidates:
+            # Multiple Ghostscript versions may coexist. The most recently
+            # installed executable is the safest default; GHOSTSCRIPT_EXE can
+            # always override it explicitly.
+            return max(
+                existing_candidates,
+                key=lambda candidate: candidate.stat().st_mtime_ns,
+            )
+
+        raise RuntimeError(
+            "Publisher EPS export requires Ghostscript. Install Ghostscript "
+            "and make gs/gswin64c available in PATH, or set GHOSTSCRIPT_EXE "
+            "to the full executable path."
+        )
+
+    @staticmethod
+    def _validate_outlined_eps(eps_path: Path) -> None:
+        """Reject empty/non-EPS output or EPS that still declares font data."""
+
+        if not eps_path.is_file() or eps_path.stat().st_size == 0:
+            raise RuntimeError("Ghostscript did not create a non-empty EPS file.")
+
+        eps_bytes = eps_path.read_bytes()
+        if not eps_bytes.startswith(b"%!PS-Adobe"):
+            raise RuntimeError("Ghostscript output is not a valid Adobe EPS file.")
+
+        font_resource_markers = (
+            b"%%BeginResource: font",
+            b"%%IncludeResource: font",
+            b"%%DocumentNeededResources: font",
+        )
+        if any(marker in eps_bytes for marker in font_resource_markers):
+            raise RuntimeError(
+                "Ghostscript EPS still declares font resources; publisher "
+                "outline safety check failed."
+            )
+
 
